# Copy this file to .local/ncs.env.
# Lab recovery mode only: Windows Flask -> MySQL in the VM.
NCS_DATABASE_URL=mysql+pymysql://root@<vm-ip>:3306/ncs_analytics
NCS_VM_HOST=<vm-ip>
NCS_MYSQL_SECURITY_MODE=recovery_root
NCS_FRONTEND_DIR=<path-to-frontend-project>
NCS_FRONTEND_PORT=5173
NCS_QUERY_HOST=127.0.0.1
NCS_QUERY_PORT=5000
NCS_QUERY_API_KEY=<random-development-api-key>
NCS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
