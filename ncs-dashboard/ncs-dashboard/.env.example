# 开发环境建议显式使用合同同构 Mock；生产环境若未配置则默认真实 API。
VITE_USE_MOCK=true

# false: 严格遵循 1.0-rc1 当前能力，预测/热力图保持 UNAVAILABLE。
# true: V3.5 视觉验收默认开启；预测/热力图/雷达使用开发演示数据，正式联调时请关闭。
VITE_DEMO_DATA=true

# Axios 基础路径。正式合同前缀固定 /api/v1。
VITE_API_BASE_URL=/api/v1

# 仅 Vite 开发服务器代理使用。
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# 仅当后端正式启用 loadPrediction 时使用；需与算法/后端确认。
# cutoff 语义：预测分界点，actual.hour 必须 < cutoffHour；forecast 可从 cutoffHour 开始。
VITE_PREDICTION_DATE=2019-09-13
VITE_PREDICTION_CUTOFF_HOUR=16
