# Copy this file outside the repository and source it before running the watcher.
export NCS_REPO=/opt/ncs-result-backend
export NCS_DATABASE_URL='mysql+pymysql://root@127.0.0.1:3306/ncs_analytics'
export NCS_ADS_EXCHANGE_ROOT=/data/ncs/ads_exchange
export NCS_MODEL_PACKAGE=/data/ncs/models/global_load_forecast/current
export NCS_PREDICTION_HORIZON=24
export NCS_ADS_SYNC_INTERVAL_SECONDS=30
# Python interpreter used by the sync scripts. start_ads_sync.sh writes the
# newest python3.x it finds here; override only when that choice is wrong.
# export NCS_PYTHON_BIN=python3.11
# Import/prediction retry limit before a package lands in rejected (import)
# or archive (prediction); default 3.
# export NCS_ADS_SYNC_MAX_ATTEMPTS=3
# Timezone used for sync log timestamps; defaults to Asia/Shanghai.
# export NCS_LOG_TZ=Asia/Shanghai
